# Local Claude Code settings (machine-specific)
.claude/

# Agent scratch (plan ledgers, review packages)
.superpowers/

# Build intermediates (e.g. the generated app icon)
build/

# Release artifacts from scripts/release.sh — DMGs are ~150 MB, never committed.
dist/

# macOS
.DS_Store

# llvm coverage droppings
*.profraw

# Licensed font — never ships in the public repo. Drop the .otf into
# app/Carabiner/BrandAssets/ locally; Brand.mono() falls back to system
# monospaced when it is absent.
app/Carabiner/BrandAssets/*.otf
