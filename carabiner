#!/usr/bin/env bash
#
# carabiner — clip media off a URL and hold onto it.
#
# A LOCAL macOS tool. It works because it runs as you, using your own browser
# cookies. Do NOT turn this into a hosted service (Instagram refuses anonymous
# requests — see CLAUDE.md, "the single most important architectural fact").
#
# Paste/share a URL. Carabiner auto-detects image vs video, handles carousels
# (all slides, or one via img_index / -s), and saves clean, QuickTime-openable
# files to ~/Downloads.
#
# Routing (proven, see CLAUDE.md gotchas):
#   video      -> yt-dlp, then re-encode to 8-bit yuv420p H.264 (QuickTime-safe)
#   image/all  -> gallery-dl (yt-dlp refuses carousel images: "No video formats!")
#
# Usage:
#   carabiner                  no URL? grab the front browser tab (else clipboard)
#   carabiner "URL"            smart: video -> yt-dlp+re-encode, images -> gallery-dl
#   carabiner -a "URL"         all carousel slides (images + videos), each QuickTime-safe
#   carabiner -s N "URL"       just slide N of a carousel
#   carabiner --silent "URL"   video without sound
#   carabiner -o DIR "URL"     output directory (default: ~/Downloads)
#   carabiner -h               help
#
# A link carrying ?img_index=N is auto-treated as -s N unless you override.
#
# Deps: yt-dlp, ffmpeg, gallery-dl  (run ./setup.sh once).
# Cookies browser: $CARABINER_BROWSER (default: chrome; also safari/firefox/brave/edge).

set -uo pipefail

# Make Homebrew-installed tools (yt-dlp, ffmpeg, gallery-dl) findable even under
# the stripped-down PATH that macOS Shortcuts / Quick Actions / global hotkeys
# hand a shell script — otherwise the tool can't find its deps when launched
# from a hotkey, only from a normal terminal.
#
# Bundled binaries win when the app supplies them; Homebrew stays the fallback so the
# Shortcut and terminal paths are untouched. The order matters and is the whole point:
# prepending Homebrew unconditionally (as this line used to) silently shadows the app's
# private copies on any machine that also has Homebrew's yt-dlp — which is every machine
# this gets tested on, so bundling would *look* like it worked. See gotcha #17.
if [ -n "${CARABINER_BIN:-}" ]; then
  export PATH="$CARABINER_BIN:/opt/homebrew/bin:/usr/local/bin:$PATH"
else
  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
fi

# Where this script actually lives, following the symlinks setup.sh drops in
# Homebrew's bin — the carousel dialog's icon is a repo file, so `carabiner` has to
# find its own clone rather than trust $PWD or the symlink's directory.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *)  self="$(cd "$(dirname "$self")" && pwd)/$target" ;;
  esac
done
HERE="$(cd "$(dirname "$self")" && pwd)"
DIALOG_ICON="$HERE/assets/Carabiner.icns"

BROWSER="${CARABINER_BROWSER:-chrome}"
OUTDIR="$HOME/Downloads"
MODE="smart"        # smart | all | slide
SLIDE=""
SILENT=0
URL=""
NOTIFY=0            # show a macOS notification when headless (launched from the hotkey)
[ -t 1 ] || NOTIFY=1
SAVED=()            # basenames saved this run — drives the notification summary

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die()  { echo "✗ $*" >&2; notify "✗ Grab failed" "$*"; exit 1; }
info() { echo "$*"; }

# Progress markers for the app's menu-bar ring.
#
# Always stderr, never stdout: stdout is the "✓ <filename>" channel that both GrabRunner
# and the Shortcut parse, and adding to it changes their input. Always on rather than
# gated behind an env var, because a terminal run shows nothing during a download either —
# the tools' own output is swallowed into `log="$(…)"` — so this improves that for free.
progress() { printf '::progress:%s\n' "$1" >&2; }

# macOS notification — only when headless (i.e. launched from the hotkey/Shortcut),
# so terminal runs stay quiet. Plain native banner (reliable, zero-setup, consistent
# on every Mac). A custom logo icon needs a per-machine-authorised app — too fragile
# for a shared tool; see gotcha #10.
notify() {  # $1 = title line, $2 = body
  [ -n "${CARABINER_NO_NOTIFY:-}" ] && return 0
  [ "$NOTIFY" -eq 1 ] || return 0
  local title="${1//\"/}" body="${2//\"/}"
  osascript -e "display notification \"$body\" with title \"Carabiner\" subtitle \"$title\"" >/dev/null 2>&1
}

usage() {
  sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1 — run ./setup.sh"
}

# Extract an Instagram shortcode from /p/, /reel/, /reels/, /tv/ (query stripped).
ig_shortcode() {
  echo "$1" | sed -nE 's#.*/(p|reel|reels|tv)/([^/?]+).*#\2#p'
}

# Pull img_index=N from the URL if present.
img_index() {
  echo "$1" | sed -nE 's#.*[?&]img_index=([0-9]+).*#\1#p'
}

platform() {
  case "$1" in
    *instagram.com*|*instagr.am*)      echo instagram ;;
    *youtube.com*|*youtu.be*)          echo youtube ;;
    *pinterest.*|*pin.it*)             echo pinterest ;;
    *)                                 echo generic ;;
  esac
}

is_url() { echo "$1" | grep -qiE '^https?://'; }

# Ask the frontmost browser window for its active tab URL (via AppleScript), so
# you can just BE on a post and fire the hotkey — no copying. Firefox has no
# scripting hook for this, so those users fall through to the clipboard.
browser_tab_url() {
  local app
  case "$BROWSER" in
    chrome) app="Google Chrome" ;;
    brave)  app="Brave Browser" ;;
    edge)   app="Microsoft Edge" ;;
    arc)    app="Arc" ;;
    safari) app="Safari" ;;
    *)      return 1 ;;
  esac
  if [ "$BROWSER" = "safari" ]; then
    osascript -e "tell application \"$app\" to get URL of front document" 2>/dev/null
  else
    osascript -e "tell application \"$app\" to get URL of active tab of front window" 2>/dev/null
  fi
}

# Figure out which URL to grab: an explicit argument wins; otherwise read the
# browser's current tab; otherwise fall back to the clipboard.
resolve_url() {
  local a="$1" u
  if is_url "$a"; then echo "$a"; return 0; fi
  u="$(browser_tab_url)"; if is_url "$u"; then echo "$u"; return 0; fi
  u="$(pbpaste 2>/dev/null)"; if is_url "$u"; then echo "$u"; return 0; fi
  return 1
}

# How many media items does this post have? (gallery-dl -g lists one URL per
# slide without downloading.) Echoes a number; 1 if it can't tell.
ig_item_count() {
  local n
  # `gallery-dl -g` prints one line per slide, but NOT all in the same shape:
  #   https://scontent…/x.jpg                     an image slide
  #   ytdl:https://www.instagram.com/p/CODE/1.mp4 a VIDEO slide, prefixed "ytdl:"
  #   | https://scontent…/AQMq…                   a continuation of the line above
  # Counting only /^https?:/ therefore misses every video slide, and a two-slide
  # video+image carousel counts as 1 — so the prompt never fires and the tool silently
  # grabs the whole set. That is exactly the symptom gotcha #15 is about, reached by a
  # different route, and it is invisible on all-image carousels which count correctly.
  # Anchoring also matters: the "| " continuation line must not be counted twice.
  n="$(gallery-dl --cookies-from-browser "$BROWSER" -g "$1" 2>/dev/null | grep -cE '^(ytdl:)?https?://')"
  [ "${n:-0}" -ge 1 ] 2>/dev/null && echo "$n" || echo 1
}

# Ask "just this slide, or the whole carousel?".
#   terminal -> text prompt;  headless (hotkey) -> plain native macOS dialog.
# Echoes: slide | all | cancel.  Safe default is `slide` (never grabs nothing by mistake).
ask_slide_or_all() {
  # $1 may be empty: when img_index proved this is a carousel we skip the probe that
  # would have counted the slides, so the prompt drops the number rather than paying a
  # whole extra tool launch to print it. Everything below has to read sensibly either way.
  local count="$1"
  local descr="a carousel" all_label="All"
  if [ -n "$count" ]; then
    descr="a carousel with $count slides"
    all_label="All $count"
  fi

  if [ -t 0 ]; then
    printf 'Carousel%s — grab just this slide or [a]ll? (s/a) ' "${count:+ of $count slides}" >&2
    local ans; read -r ans
    case "$ans" in a|A|all|All) echo all ;; *) echo slide ;; esac
    return 0
  fi

  # Branded icon when the repo's .icns is reachable, the generic note icon when it
  # isn't (a stray copy of the script, or a clone missing assets/) — the prompt has to
  # keep working either way. `POSIX file` is resolved outside the System Events tell
  # block so it's AppleScript resolving the path, not the app.
  local icon_clause="with icon note" icon_setup=""
  if [ -f "$DIALOG_ICON" ]; then
    icon_setup="set iconRef to POSIX file \"${DIALOG_ICON//\"/\\\"}\""
    icon_clause="with icon iconRef"
  fi

  # Clicking a button named "Cancel" does NOT come back as `button returned` — AppleScript
  # makes it the dialog's cancel button and THROWS error -128 ("User canceled"), so without
  # the try block osascript exits 1 with nothing on stdout, the case below sees an empty
  # answer, and its "dialog failed" default silently grabs slide 1. Cancel and "grab a
  # slide" were literally the same button until 2026-08-02. The catch pins -128
  # specifically: any *other* error still comes out empty and takes the safe default,
  # which is what a genuinely broken dialog should do.
  local b
  b="$(osascript 2>/dev/null <<EOF
$icon_setup
try
  tell application "System Events"
    activate
    set r to button returned of (display dialog "This Instagram post is $descr.\n\nGrab just the slide you're on, or the whole carousel?" buttons {"Cancel", "This slide", "$all_label"} default button "$all_label" with title "Carabiner" $icon_clause)
  end tell
  return r
on error number -128
  return "Cancel"
end try
EOF
)"
  case "$b" in
    "This slide") echo slide ;;
    "Cancel")     echo cancel ;;
    All*)         echo all ;;
    *)            echo slide ;;   # dialog failed → safe default
  esac
}

# Re-encode any video to a QuickTime-friendly 8-bit yuv420p H.264 mp4.
#   reencode <in> <out> <silent 0|1>
# Work out the cheapest ffmpeg arguments that still produce a QuickTime-openable file,
# into the REENC_ARGS array.
#
# Gotcha #3 is about Instagram's *odd* pixel formats — 10-bit, yuv444p — not about every
# video it serves. Most reels are already 8-bit yuv420p H.264, and re-encoding those burns
# ~12s on a 45s clip to produce a slightly worse copy of a file that was already fine. One
# `ffmpeg -i` probe costs ~0.05s, so it is always worth asking before burning the encode.
#
# Deliberately conservative: anything we are not certain about falls through to the full
# libx264 re-encode, which is the guaranteed fix. Do not widen the "safe" test without
# re-reading gotcha #3 — a file that plays here but not in QuickTime is the whole bug.
plan_reencode() {
  local src="$1" silent="$2" info vline aline vsafe=0 asafe=0

  # ffmpeg exits non-zero when given no output file, which is exactly how we are calling
  # it — the stream table we want is on stderr either way.
  info="$(ffmpeg -hide_banner -i "$src" 2>&1 || true)"
  vline="$(printf '%s\n' "$info" | grep -m1 'Stream #.*Video:')"
  aline="$(printf '%s\n' "$info" | grep -m1 'Stream #.*Audio:')"

  # The trailing character class is load-bearing: "yuv420p10le" and "yuv420p12le" both
  # contain "yuv420p", and those are precisely the 10-bit files gotcha #3 is about. A
  # plain substring match would copy the one format we must always re-encode.
  if printf '%s' "$vline" | grep -q 'Video: h264' \
     && printf '%s' "$vline" | grep -qE 'yuv420p([^0-9a-z]|$)'; then
    vsafe=1
  fi

  # No audio stream at all is fine; otherwise only AAC is safe to pass through.
  if [ -z "$aline" ] || printf '%s' "$aline" | grep -q 'Audio: aac'; then
    asafe=1
  fi

  if [ "$vsafe" -eq 1 ]; then
    REENC_ARGS=(-c:v copy)
    if   [ "$silent" -eq 1 ]; then REENC_ARGS+=(-an)
    elif [ "$asafe"  -eq 1 ]; then REENC_ARGS+=(-c:a copy)
    else                           REENC_ARGS+=(-c:a aac)
    fi
    # Cheap here and it means the file starts playing before it has fully loaded.
    REENC_ARGS+=(-movflags +faststart)
    info "  (already QuickTime-safe → remuxing, no re-encode)"
  else
    REENC_ARGS=(-c:v libx264 -pix_fmt yuv420p)
    if [ "$silent" -eq 1 ]; then REENC_ARGS+=(-an); else REENC_ARGS+=(-c:a aac); fi
    info "  (re-encoding to 8-bit yuv420p H.264 — this is the slow path)"
  fi
}

# Turn any downloaded video into a QuickTime-friendly 8-bit yuv420p H.264 mp4 —
# by remuxing when it already is one, and by re-encoding when it isn't.
reencode() {
  local src="$1" out="$2" silent="$3"
  local -a REENC_ARGS
  plan_reencode "$src" "$silent"
  # The ring creeps through the convert stage at a rate set by which of these it is: a
  # remux is ~0.2s, a real encode can be ~12s (gotcha #21). Same stage, very different wait.
  case " ${REENC_ARGS[*]} " in
    *" -c:v copy "*) progress "convert:remux" ;;
    *)               progress "convert:encode" ;;
  esac
  ffmpeg -y -loglevel error -i "$src" "${REENC_ARGS[@]}" "$out"
}

lower() { echo "$1" | tr 'A-Z' 'a-z'; }

# ---------------------------------------------------------------------------
# Instagram: video via yt-dlp (single post or one slide), re-encoded.
# Returns: 0 = got a video, 10 = no video here (caller falls back to images),
#          1 = hard error.
# ---------------------------------------------------------------------------
ig_video() {
  local url="$1" code="$2" slide="$3" silent="$4"
  local tmp="$OUTDIR/.carabiner_src_$$"
  local -a args=(--cookies-from-browser "$BROWSER" -o "${tmp}.%(ext)s")
  [ -n "$slide" ] && args+=(--playlist-items "$slide")
  [ "$silent" -eq 1 ] && args+=(-f "bv")
  # Ask yt-dlp for the marker format directly rather than screen-scraping its progress bar.
  # --newline turns the \r-overwritten bar into discrete lines; --progress forces it even
  # though stdout is a pipe; --progress-delta throttles it to something a 30fps ring can use.
  args+=(--newline --progress --progress-delta 0.2
         --progress-template "download:::progress:download:%(progress._percent_str)s")

  local log rc
  # Progress has to reach the app *live*, but the whole output is still needed afterwards:
  # the "no video formats" test below (gotcha #4) reads it to decide whether this was an
  # image slide. So tee it — everything into `log`, marker lines onward to stderr as they
  # happen.
  #
  # `--newline` above is the flag that makes any of this work — see gotcha #23. yt-dlp
  # rewrites one progress line with `\r`, and `grep --line-buffered` only ever emits whole
  # lines, so without it zero markers reach the app for the entire download.
  #
  # PYTHONUNBUFFERED=1, by contrast, is purely defensive and is kept only because it costs
  # nothing. CPython does block-buffer a piped stdout, but yt-dlp calls `out.flush()` on
  # every progress write, so that buffering never applies: measured 2026-07-31 against the
  # real bundled binary through this exact pipeline, markers arrive at the same times with
  # it set and with `env -u PYTHONUNBUFFERED` (0.00/0.35/0.64/1.41/2.49/3.09s either way).
  # An earlier comment here called it load-bearing on the strength of a 1.7s measurement
  # that was of the *test stub* — a bare `python3 -c` that never flushed — not of yt-dlp.
  # It stays as insurance against a future yt-dlp that stops flushing; do not promote it
  # back to load-bearing, and do not delete `--newline` thinking this covers for it.
  #
  # `rc=$?` is correct here and PIPESTATUS is not needed: `set -uo pipefail` (top of file)
  # carries yt-dlp's non-zero status out of the pipeline, and `grep` sits in a process
  # substitution rather than in the pipeline, so its own exit status is not part of it.
  # That last point is what makes this safe — grep exits 1 when it matches nothing, which
  # is every image post, and as a pipeline stage that 1 would become yt-dlp's exit code
  # and take gotcha #4's fallback with it.
  log="$(PYTHONUNBUFFERED=1 yt-dlp "${args[@]}" "$url" 2>&1 \
         | tee >(grep --line-buffered '^::progress:' >&2))"; rc=$?

  if [ $rc -ne 0 ]; then
    rm -f "${tmp}".* 2>/dev/null
    # "No video formats found!" (image slide) -> let the caller try gallery-dl.
    if echo "$log" | grep -qiE 'no video|there.?s no video|unsupported url'; then
      return 10
    fi
    echo "$log" >&2
    return 1
  fi

  local src
  src="$(ls "${tmp}".* 2>/dev/null | head -n1)"
  [ -n "$src" ] || { echo "$log" >&2; return 1; }

  local suffix=""
  [ -n "$slide" ] && suffix="_s${slide}"
  [ "$silent" -eq 1 ] && suffix="${suffix}_silent"
  local out="$OUTDIR/${code}${suffix}_fixed.mp4"

  if reencode "$src" "$out" "$silent"; then
    rm -f "${tmp}".*
    info "  ✓ ${out##*/}"
    SAVED+=("${out##*/}")
    return 0
  fi
  rm -f "${tmp}".*
  return 1
}

# ---------------------------------------------------------------------------
# Instagram: images (and mixed carousels) via gallery-dl. Videos that come
# through are re-encoded so -a stays QuickTime-safe too.
#   ig_gallery <url> <code> <slide-or-empty>
# ---------------------------------------------------------------------------
ig_gallery() {
  local url="$1" code="$2" slide="$3"
  local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/carabiner_gl_XXXXXX")"
  local -a args=(--cookies-from-browser "$BROWSER" -D "$tmp" -q)
  [ -n "$slide" ] && args+=(--range "$slide")

  # Keep gallery-dl's own words. This used to run bare and die with a guess — "private
  # post? wrong browser cookies?" — which is useless in a notification, because that is
  # the one place you cannot go and look at the terminal output. gallery-dl already says
  # whether it was a 404, a login wall, a rate limit or a cookie problem; report that.
  local log rc
  # gallery-dl has no progress output of any kind, so this stage creeps rather than
  # tracking. Deliberately left as one marker: there is nothing to report until the files
  # land, and the per-item markers below cover the part that takes the time.
  progress download
  log="$(gallery-dl "${args[@]}" "$url" 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -rf "$tmp"
    echo "$log" >&2
    # Last non-empty line is gallery-dl's actual complaint; trim the noisy prefixes it
    # puts on log lines so the notification body stays readable.
    local reason
    reason="$(printf '%s\n' "$log" | grep -v '^\s*$' | tail -n1 \
              | sed -E 's/^\[[^]]+\]\[[^]]+\] //; s/^\[[^]]+\] //')"
    die "gallery-dl failed: ${reason:-no output (exit $rc)}"
  fi

  local n=0 i=0 f ext base out total
  # Counted up front so each item can be announced as "i of n" — the ring divides its
  # download+convert range by n, so without the total a five-slide carousel would snap to
  # the end of the range on the first file.
  total="$(find "$tmp" -type f ! -name '*.json' | wc -l | tr -d ' ')"
  while IFS= read -r -d '' f; do
    i=$((i+1))
    progress "item:$i:$total"
    ext="$(lower "${f##*.}")"
    if [ -n "$slide" ]; then base="${code}_s${slide}"; else base="${code}_${i}"; fi
    case "$ext" in
      mp4|mov|webm|mkv|m4v)
        out="$OUTDIR/${base}_fixed.mp4"
        reencode "$f" "$out" 0 || { echo "✗ re-encode failed: $f" >&2; continue; }
        ;;
      *)
        out="$OUTDIR/${base}.${ext}"
        mv -f "$f" "$out"
        ;;
    esac
    info "  ✓ ${out##*/}"
    SAVED+=("${out##*/}")
    n=$((n+1))
  done < <(find "$tmp" -type f ! -name '*.json' -print0 | sort -z)

  rm -rf "$tmp"
  [ "$n" -gt 0 ] || die "gallery-dl downloaded nothing for this URL."
}

# ---------------------------------------------------------------------------
# arg parsing
# ---------------------------------------------------------------------------
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)   usage ;;
    -a|--all)    MODE="all"; shift ;;
    -s|--slide)  MODE="slide"; SLIDE="${2:-}"; shift 2 ;;
    --silent)    SILENT=1; shift ;;
    -o|--out)    OUTDIR="${2:-}"; shift 2 ;;
    -b|--browser) BROWSER="${2:-}"; shift 2 ;;
    -*)          die "unknown option: $1 (try -h)" ;;
    *)           URL="$1"; shift ;;
  esac
done

URL="$(resolve_url "$URL")" || die "no URL. Pass one, or open the post in $BROWSER (or copy its link) and try again."
[ -n "$SLIDE" ] || [ "$MODE" != "slide" ] || die "-s needs a slide number, e.g. -s 2"

require yt-dlp
require ffmpeg
require gallery-dl

mkdir -p "$OUTDIR" || die "cannot create output dir: $OUTDIR"

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
PLATFORM="$(platform "$URL")"
info "carabiner → $PLATFORM  (cookies: $BROWSER, out: ${OUTDIR/#$HOME/~})"

# Say something *now*. Cookie extraction, the download and any re-encode all happen before
# there is a result to report, and until then a slow grab and a hotkey that never fired
# look identical. Suppressed in a terminal (NOTIFY) and under the app, which posts its own
# branded equivalent and replaces it in place — this one is for the Shortcut path.
notify "Grabbing…" "Saving to ${OUTDIR/#$HOME/~}"

case "$PLATFORM" in
  instagram)
    CODE="$(ig_shortcode "$URL")"
    [ -n "$CODE" ] || CODE="ig"     # fallback name if shortcode isn't in the URL

    # A link may carry ?img_index=N (you navigated to a slide). In smart mode, ask
    # whenever the post turns out to be a multi-slide carousel.
    #
    # Do NOT gate this on img_index: Instagram only adds that param once you move off
    # the first slide, so a carousel you just opened looks exactly like a single post
    # and the prompt never appeared — it silently grabbed the whole set instead.
    # No img_index simply means you're on slide 1.
    if [ "$MODE" = "smart" ]; then
      IDX="$(img_index "$URL")"
      # Only /p/ posts can be carousels — /reel/, /reels/ and /tv/ are always one
      # video — so reels don't pay for the gallery-dl probe ig_item_count costs.
      # img_index=N with N>=2 can only have come from a carousel: Instagram adds the
      # parameter once you scroll off slide 1 (gotcha #15). That is proof from the URL
      # alone, so skip the ig_item_count probe entirely — it is a whole extra tool launch
      # (~0.8s against Homebrew, ~13s against the bundled PyInstaller build) spent
      # confirming something already known. The count is only cosmetic in the prompt, and
      # the "all" branch hands the whole URL to gallery-dl, which counts them itself.
      # Note this cannot be inverted: a *missing* img_index proves nothing, which is
      # exactly the trap gotcha #15 documents, so that case still has to probe.
      COUNT=""
      CAROUSEL=0
      if [ -n "$IDX" ] && [ "${IDX:-0}" -ge 2 ] 2>/dev/null; then
        CAROUSEL=1
      else
        case "$URL" in
          */p/*)
            progress probe
            COUNT="$(ig_item_count "$URL")"
            if [ "${COUNT:-1}" -gt 1 ]; then CAROUSEL=1; fi
            ;;
        esac
      fi

      if [ "$CAROUSEL" -eq 1 ]; then
        info "  (carousel${COUNT:+: $COUNT slides} — asking…)"
        # The ring freezes here rather than creeping: what this is waiting on is the user.
        progress prompt
        case "$(ask_slide_or_all "$COUNT")" in
          all)    MODE="all";                            info "  → grabbing all${COUNT:+ $COUNT} slides" ;;
          cancel) info "  cancelled."; exit 0 ;;
          *)      MODE="slide"; SLIDE="${IDX:-1}";       info "  → grabbing slide ${IDX:-1} only" ;;
        esac
      elif [ -n "$IDX" ]; then
        MODE="slide"; SLIDE="$IDX"; info "  (img_index=$IDX detected → slide $IDX)"
      fi
    fi

    case "$MODE" in
      all)
        ig_gallery "$URL" "$CODE" ""
        ;;
      slide)
        # A slide can be video or image — try video, fall back to gallery-dl.
        ig_video "$URL" "$CODE" "$SLIDE" "$SILENT"; rc=$?
        [ "$rc" -eq 10 ] && ig_gallery "$URL" "$CODE" "$SLIDE"
        [ "$rc" -eq 1 ] && die "download failed."
        ;;
      smart)
        ig_video "$URL" "$CODE" "" "$SILENT"; rc=$?
        [ "$rc" -eq 10 ] && ig_gallery "$URL" "$CODE" ""
        [ "$rc" -eq 1 ] && die "download failed."
        ;;
    esac
    ;;

  # No progress markers on any of the three branches below — deliberate, and recorded so it
  # doesn't get read as a broken ring (gotcha #23). Each is a single-shot yt-dlp call with
  # no progress template and no tee/grep pipeline, so the ring stays at the resolve stage's
  # 5% ceiling for the whole download and then jumps when `progress save` fires. Wiring them
  # up means giving each the ig_video treatment; Instagram is what this tool is for, so that
  # cost hasn't been paid yet.
  youtube)
    # Prefer QuickTime-friendly H.264/AAC; caps effectively at 1080p (4k is vp9/av1).
    yt-dlp --cookies-from-browser "$BROWSER" \
      -S "vcodec:h264,res,acodec:aac" --merge-output-format mp4 \
      -o "$OUTDIR/%(id)s.%(ext)s" "$URL" || die "yt-dlp failed."
    info "  ✓ saved to ${OUTDIR/#$HOME/~}"
    SAVED+=("YouTube video")
    ;;

  pinterest)
    # Public pins usually need no cookies; sending them is harmless.
    yt-dlp --cookies-from-browser "$BROWSER" \
      -o "$OUTDIR/pin_%(id)s.%(ext)s" "$URL" || die "yt-dlp failed."
    info "  ✓ saved to ${OUTDIR/#$HOME/~}"
    SAVED+=("Pinterest pin")
    ;;

  generic)
    yt-dlp --cookies-from-browser "$BROWSER" \
      -o "$OUTDIR/%(id)s.%(ext)s" "$URL" || die "yt-dlp failed (unsupported site?)."
    info "  ✓ saved to ${OUTDIR/#$HOME/~}"
    SAVED+=("Download")
    ;;
esac

progress save
# Headless success → one tidy notification summarising what landed.
if [ "${#SAVED[@]}" -gt 0 ]; then
  if [ "${#SAVED[@]}" -eq 1 ]; then
    notify "✓ Saved to Downloads" "${SAVED[0]}"
  else
    notify "✓ Saved ${#SAVED[@]} files" "${SAVED[0]}  (+$(( ${#SAVED[@]} - 1 )) more)"
  fi
fi
info "Done."
