# Both of these are generated by `xcodegen generate` from project.yml, which is the
# single source of truth — hand edits to either are silently overwritten.
Carabiner.xcodeproj/
Carabiner/Info.plist
Carabiner/Carabiner.entitlements
# Same story for the Safari extension target: its NSExtension dict lives in project.yml's
# info.properties, and the file at this path is xcodegen's generated output, not source.
CarabinerSafariExtension/Info.plist
# xcodegen leaves "Carabiner 2.xcodeproj" style copies behind if the original is in use
Carabiner*.xcodeproj/
build/
# Third-party binaries pulled by scripts/fetch-deps.sh — ~150 MB, never committed.
.deps/
.DS_Store
DerivedData/
*.xcuserstate
# llvm coverage droppings from xcodebuild test
*.profraw
